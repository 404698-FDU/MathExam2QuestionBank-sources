{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_no",
    "stem_latex",
    "options_latex",
    "answer_latex",
    "analysis_latex",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "image_only_question_standardization_v1"
      ]
    },
    "question_no": {
      "type": "integer",
      "minimum": 1
    },
    "stem_latex": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "options_latex": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "no",
          "options"
        ],
        "properties": {
          "no": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "content_latex"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "content_latex": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "answer_latex": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "analysis_latex": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "severity",
          "message"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image_unclear",
              "boundary_suspect",
              "answer_missing",
              "type_conflict",
              "content_missing",
              "foreign_content",
              "other"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
